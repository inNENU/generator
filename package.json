{
  "name": "innenu-generator",
  "version": "0.25.0",
  "description": "inNENU 生成器",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:inNENU/generator.git"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/component-schema.d.ts",
      "default": "./dist/component-schema.js"
    },
    "./schemas/*": "./schemas/*",
    "./typings": {
      "types": "./dist/typings.d.ts",
      "default": "./dist/typings.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run schema",
    "schema": "unrun scripts/generate-schema.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "upath": "^3.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdit/plugin-figure": "1.3.0",
    "@mr-hope/tsconfig": "0.0.4",
    "@types/ali-oss": "6.23.4",
    "@types/node": "^22.12.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vue/compiler-dom": "^3.5.45",
    "@vuepress/markdown": "2.0.0-rc.31",
    "husky": "9.1.7",
    "js-yaml": "^5.5.0",
    "markdown-it": "15.0.3",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.1.0"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
